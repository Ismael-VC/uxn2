( )

|00 @System &vector $2 &wst $1 &rst $1 &pad $4 &r $2 &g $2 &b $2 &debug $1 &halt $1
|20 @Screen &vector $2 &width $2 &height $2 &auto $1 &pad $1 &x $2 &y $2 &addr $2 &pixel $1 &sprite $1
|80 @Controller &vector $2 &button $1 &key $1
|90 @Mouse &vector $2 &x $2 &y $2 &state $1 &pad $3 &scrollx $2 &scrolly $2

|000

	@position &x $2 &y $2

|100

@on-reset ( -> )
	#375e .System/r DEO2
	#286c .System/g DEO2
	#2358 .System/b DEO2
	;on-mouse .Mouse/vector DEO2
	;on-button .Controller/vector DEO2
	<draw-guide>
	#0028 #0028 <move>
	BRK

@on-button ( -> )
	.Controller/button DEI
	( | handlers )
	DUP #10 NEQ ?{
		.position/x LDZ2 .position/y LDZ2 #0004 SUB2 <move> }
	DUP #20 NEQ ?{
		.position/x LDZ2 .position/y LDZ2 #0004 ADD2 <move> }
	DUP #40 NEQ ?{
		.position/x LDZ2 #0004 SUB2 .position/y LDZ2 <move> }
	DUP #80 NEQ ?{
		.position/x LDZ2 #0004 ADD2 .position/y LDZ2 <move> }
	DUP #14 NEQ ?{
		.position/x LDZ2 .position/y LDZ2 #0040 SUB2 <move> }
	DUP #24 NEQ ?{
		.position/x LDZ2 .position/y LDZ2 #0040 ADD2 <move> }
	DUP #44 NEQ ?{
		.position/x LDZ2 #0040 SUB2 .position/y LDZ2 <move> }
	DUP #84 NEQ ?{
		.position/x LDZ2 #0040 ADD2 .position/y LDZ2 <move> }
	DUP #01 NEQ ?{ <toggle-size> }
	DUP #02 NEQ ?{ <toggle-theme> }
	DUP #08 NEQ ?{ <toggle-pos> }
	POP <draw-portraits>
	BRK

@on-mouse ( -> )
	.Mouse/x DEI2 .Mouse/y DEI2 <move>
	BRK

(
@|drawing )

@<toggle-pos> ( -- )
	.position/x LDZ2 #8000 NEQ2 ?{ #0000 DUP2 !<move> }
	#8000 DUP2 !<move>

@<toggle-size> ( -- )
	.Screen/width DEI2 #0200 EQU2 ?{
		#0200 .Screen/width DEO2
		#0200 .Screen/height DEO2
		<draw-guide> !<draw-portraits> }
	#0180 .Screen/width DEO2
	#0180 .Screen/height DEO2
	<draw-guide> !<draw-portraits>

@<toggle-theme> ( -- )
	#ff00 .System/r DEI2 EQU2 ?{
		#ff00 .System/r DEO2
		#0ff0 .System/g DEO2
		#00ff .System/b DEO2
		JMP2r }
	#00ff .System/r DEO2
	#0ff0 .System/g DEO2
	#ff00 .System/b DEO2
	JMP2r

@<move> ( x* y* -- )
	( | clear )
	.position/x LDZ2 #0020 SUB2 .Screen/x DEO2
	.position/y LDZ2 #0020 SUB2 .Screen/y DEO2
	[ LIT2 71 -Screen/auto ] DEO
	;fill-icn .Screen/addr DEO2
	#f8
	&>l
		#40 .Screen/sprite DEO
		INC DUP ?&>l
	POP OVR2 <phex>
	#2018 DEO
	DUP2 <phex>
	#0a18 DEO
	( | update )
	.position/y STZ2
	.position/x STZ2
	( >> )

@<draw-portraits> ( -- )
	.position/x LDZ2 .Screen/x DEO2
	.position/y LDZ2 .Screen/y DEO2
	[ LIT2 36 -Screen/auto ] DEO
	.Mouse/state DEI .Controller/button DEI #0f AND ORA ?<draw-box>
	( | top-left )
	.Screen/x DEI2k #0000 ADD2 ROT DEO2
	.Screen/y DEI2k #0020 SUB2 ROT DEO2
	#8140 ORA <draw-portrait>
	.Screen/x DEI2k #0008 SUB2 ROT DEO2
	.Screen/y DEI2k #0020 SUB2 ROT DEO2
	#9140 ORA <draw-portrait>
	.Screen/x DEI2k #0000 SUB2 ROT DEO2
	.Screen/y DEI2k #0018 ADD2 ROT DEO2
	#b140 ORA <draw-portrait>
	.Screen/x DEI2k #0008 ADD2 ROT DEO2
	.Screen/y DEI2k #0020 ADD2 ROT DEO2
	#a140 ORA <draw-portrait>
	( | pixels )
	[ LIT2 00 -Screen/auto ] DEO
	.position/x LDZ2 .Screen/x DEO2
	.position/y LDZ2 .Screen/y DEO2
	#43 .Screen/pixel DEO
	.position/x LDZ2 #001f ADD2 .Screen/x DEO2
	.position/y LDZ2 #001f ADD2 .Screen/y DEO2
	#43 .Screen/pixel DEO
	.position/x LDZ2 #0020 SUB2 .Screen/x DEO2
	.position/y LDZ2 #0020 SUB2 .Screen/y DEO2
	#43 .Screen/pixel DEO
	JMP2r

@<draw-portrait> ( color -- )
	;portrait-chr .Screen/addr DEO2
	.Screen/sprite DEOk DEOk DEOk DEO
	JMP2r

@<draw-box> ( -- )
	( | top left )
	.Screen/x DEI2k #0020 SUB2 ROT DEO2
	.Screen/y DEI2k #0020 SUB2 ROT DEO2
	;box-icn .Screen/addr DEO2
	#43 .Screen/sprite DEOk DEOk DEOk DEO
	( | top right )
	.Screen/x DEI2k #0038 ADD2 ROT DEO2
	.Screen/y DEI2k #0020 SUB2 ROT DEO2
	;box-icn .Screen/addr DEO2
	#53 .Screen/sprite DEOk DEOk DEOk DEO
	( | bottom right )
	.Screen/x DEI2k #0000 ADD2 ROT DEO2
	.Screen/y DEI2k #0018 ADD2 ROT DEO2
	;box-icn .Screen/addr DEO2
	#73 .Screen/sprite DEOk DEOk DEOk DEO
	( | bottom left )
	.Screen/x DEI2k #0038 SUB2 ROT DEO2
	.Screen/y DEI2k #0020 ADD2 ROT DEO2
	;box-icn .Screen/addr DEO2
	#63 .Screen/sprite DEOk DEOk DEOk DEO
	JMP2r

@<draw-circle> ( color -- )
	[ LITr -Screen/x ] DEI2r ;circle-chr .Screen/addr DEO2
	DUP .Screen/sprite DEO
	DUP #10 ORA .Screen/sprite DEO
	.Screen/y DEI2k #0008 ADD2 ROT DEO2
	DUP #20 ORA .Screen/sprite DEO
	#30 ORA .Screen/sprite DEO
	.Screen/y DEI2k #0008 SUB2 ROT DEO2
	[ LIT2r 0010 ] ADD2r [ LITr -Screen/x ] DEO2r
	JMP2r

@<draw-guide> ( -- )
	#0080 .Screen/x DEO2
	#0080 .Screen/y DEO2
	#82 .Screen/pixel DEO
	#93 .Screen/pixel DEO
	#a1 .Screen/pixel DEO
	#0008 DUP2 .Screen/x DEO2
	.Screen/y DEO2
	#e2 .Screen/auto DEO
	;guide-icn .Screen/addr DEO2
	#0f00
	&>l
		#01 .Screen/sprite DEO
		INC GTHk ?&>l
	POP2
	( | circles 1bpp )
	#0088 .Screen/x DEO2
	#0008 .Screen/y DEO2
	#01 .Screen/auto DEO
	#0f00
	&>ll
		DUP <draw-circle>
		INC GTHk ?&>ll
	POP2
	( | circles 2bpp )
	#0088 .Screen/x DEO2
	#0018 .Screen/y DEO2
	#01 .Screen/auto DEO
	#0f00
	&>lll
		DUP #80 ORA <draw-circle>
		INC GTHk ?&>lll
	POP2 JMP2r

@<update-cursor> ( color addr* -- )
	[ LIT2 00 -Screen/auto ] DEO
	;fill-icn .Screen/addr DEO2
	#40 <draw-cursor>
	.Mouse/x DEI2 ,<draw-cursor>/x STR2
	.Mouse/y DEI2 ,<draw-cursor>/y STR2
	.Screen/addr DEO2

@<draw-cursor> ( color -- )
	[ LIT2 &x $2 ] .Screen/x DEO2
	[ LIT2 &y $2 ] .Screen/y DEO2
	.Screen/sprite DEO
	JMP2r

@<phex> ( short* -: )
	SWP /b
	&b ( byte -: )
	DUP #04 SFT /c
	&c ( byte -: )
	#0f AND DUP #09 GTH #27 MUL ADD [ LIT "0 ] ADD #18 DEO
	JMP2r

@guide-icn [ 8000 0000 0000 0000 ]

@fill-icn [ ffff ffff ffff ffff ]

@cursor-icn [ 80c0 e0f0 f8e0 1000 ]

@portrait-chr [
	070f 1e1d 1b3b 3b3b f0e0 c0c0 d08b 8080
	f76f cf9f 9f5f 5f5f 0000 0007 1c40 4040
	fffb f975 7576 7667 0000 3164 0406 0607
	efef efef eddd 9e1e 0060 8000 0000 0000
	3b2b 280d 0105 0506 8080 8081 e1f1 f1f0
	5f6c 639b 0f27 77ab 4060 639b 0f27 67ab
	0dc8 b0e5 cded fdfc 0dc8 b0e4 ccec fcfc
	5e1e 1c9c 9d1d 5d59 4000 0080 8000 4040
	0607 0707 070e 0e0e f0f0 f0f0 f0e0 e0e0
	fb73 7fb7 bbbf bfdd f373 7b37 3b3f 3f1c
	ffff ffff ffff ffff ffff ffff ffff ff7f
	dba7 97f7 f7ed dd9d c080 90f0 f0e0 c080
	1e0e 0000 0000 0000 c0c0 f0ff ffff ffff
	ee03 0000 0000 0000 0e12 fcff ffff ffff
	fffc f30f 1f1f 1f3f 9f3c f30f dfdf dfbf
	3c80 8080 80c0 c0e0 0003 3fbf bfbf dfef ]

@box-icn [
	0000 0000 0001 0204 0000 0f30 c000 0000
	03fc 0000 0000 0000 ff00 0000 0000 0000
	0808 1010 2020 2020 0000 0000 0000 0000
	0000 0000 0000 0000 0000 0000 0000 0000
	4040 4040 4040 8080 0000 0000 0000 0000
	0000 0000 0000 0000 0000 0000 0000 0000
	8080 8080 8080 8080 0000 0000 0000 0000
	0000 0000 0000 0000 0000 0000 0000 0000 ]

@circle-chr [ 071f 3c70 60e3 c7c7 0000 030f 1f1f 3f3f ]

